\@writefile{toc}{\contentsline {subsection}{\numberline {B.1}Cost of the components}{25}{subsection.a.B.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {B1}{\ignorespaces Cost per invocation and invocation count. Exact minimisation of the $k$-means objective is NP-hard in general and remains so for $k = 2$ in arbitrary dimension \citep  {inaba1994}, so Lloyd's local-search heuristic \citep  {lloyd1982} is used, restarted ten times.}}{25}{table.1}\protected@file@percent }
\newlabel{tab:complexity}{{B1}{25}{Cost per invocation and invocation count. Exact minimisation of the $k$-means objective is NP-hard in general and remains so for $k = 2$ in arbitrary dimension \citep {inaba1994}, so Lloyd's local-search heuristic \citep {lloyd1982} is used, restarted ten times}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.2}Parallel execution}{26}{subsection.a.B.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {B1}{\ignorespaces Strong scaling of the model-selection workload on the reference machine, $72$ independent units, BLAS pinned to one thread per worker. Scaling is near-linear to $8$ workers ($6.9\times $, $87\%$ efficiency) and the knee falls at $12$, the physical core count. Beyond it the additional workers occupy SMT siblings that share execution units with an already-saturated core, so throughput still rises but efficiency falls to $56\%$ at $18$ workers and $45\%$ at $24$. The production runs use $18$: past the efficiency knee, but chosen for wall time on an otherwise idle machine. The efficiency figure is not a curiosity: at $56\%$, the clustering stage costs $3.6$~h rather than the $2.0$~h that dividing its serial cost by $18$ would suggest.}}{27}{figure.1}\protected@file@percent }
\newlabel{fig:scaling}{{B1}{27}{Strong scaling of the model-selection workload on the reference machine, $72$ independent units, BLAS pinned to one thread per worker. Scaling is near-linear to $8$ workers ($6.9\times $, $87\%$ efficiency) and the knee falls at $12$, the physical core count. Beyond it the additional workers occupy SMT siblings that share execution units with an already-saturated core, so throughput still rises but efficiency falls to $56\%$ at $18$ workers and $45\%$ at $24$. The production runs use $18$: past the efficiency knee, but chosen for wall time on an otherwise idle machine. The efficiency figure is not a curiosity: at $56\%$, the clustering stage costs $3.6$~h rather than the $2.0$~h that dividing its serial cost by $18$ would suggest}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B2}{\ignorespaces Wall-clock cost at $m = 1000$ on an AMD Ryzen~9 9900X (12~cores, 24~threads, $46$~GiB) with $18$ workers. The evidence differs by row and is stated rather than blurred: the fidelity stage is instrumented; synthesis is the interval over which its $1.44 \times 10^{5}$ outputs were written, so it includes any idle time inside that interval; the clustering stage was not instrumented, so its entry is a measurement on a uniform random sample of $3000$ of its $1.44 \times 10^{5}$ inputs, run at the same worker count, scaled to the full set; this is consistent with the loose upper bound of $5.6$~h implied by its output timestamps.}}{27}{table.2}\protected@file@percent }
\newlabel{tab:cost}{{B2}{27}{Wall-clock cost at $m = 1000$ on an AMD Ryzen~9 9900X (12~cores, 24~threads, $46$~GiB) with $18$ workers. The evidence differs by row and is stated rather than blurred: the fidelity stage is instrumented; synthesis is the interval over which its $1.44 \times 10^{5}$ outputs were written, so it includes any idle time inside that interval; the clustering stage was not instrumented, so its entry is a measurement on a uniform random sample of $3000$ of its $1.44 \times 10^{5}$ inputs, run at the same worker count, scaled to the full set; this is consistent with the loose upper bound of $5.6$~h implied by its output timestamps}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.3}Measured cost}{27}{subsection.a.B.3}\protected@file@percent }
