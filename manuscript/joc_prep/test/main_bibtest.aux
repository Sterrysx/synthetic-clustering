\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Normal (spherical) components: geometry largely preserved under synthesis. Rows are the original data (top) and one CART synthetic replicate (bottom); columns are the true group labels, the $k$-means partition and the Ward partition. In the two partition columns, colours are matched across rows by Hungarian alignment, so the same colour denotes corresponding groups in the original and synthetic panels. The lower-left panel is drawn in a single colour: the group label in the synthetic data is itself synthesised, so it is a prediction from the synthetic features rather than a planted truth, and it has no bijective correspondence with the original groups. Both rows contain the same number of observations ($N = 1000$); the synthetic panels can look sparser only because CART resamples observed values, so that points coincide more often. Scenario: $k = 2$, $p = 2$, $\rho = 0$, $\sigma = 2$.}}{10}{figure.1}\protected@file@percent }
\newlabel{fig:normal}{{1}{10}{Normal (spherical) components: geometry largely preserved under synthesis. Rows are the original data (top) and one CART synthetic replicate (bottom); columns are the true group labels, the $k$-means partition and the Ward partition. In the two partition columns, colours are matched across rows by Hungarian alignment, so the same colour denotes corresponding groups in the original and synthetic panels. The lower-left panel is drawn in a single colour: the group label in the synthetic data is itself synthesised, so it is a prediction from the synthetic features rather than a planted truth, and it has no bijective correspondence with the original groups. Both rows contain the same number of observations ($N = 1000$); the synthetic panels can look sparser only because CART resamples observed values, so that points coincide more often. Scenario: $k = 2$, $p = 2$, $\rho = 0$, $\sigma = 2$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Gamma (right-skewed) components: the same synthesis mechanism breaks smooth tails into axis-aligned blocks. Panel layout, colour matching, the single-colour lower-left panel and the scenario are as in Fig.~\ref {fig:normal}, and both rows again contain $N = 1000$ observations. Comparing the lower-left panel with the upper-left one shows the artefact directly: the continuous density gradient of the original becomes a set of discrete rectangular patches.}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:gamma}{{2}{11}{Gamma (right-skewed) components: the same synthesis mechanism breaks smooth tails into axis-aligned blocks. Panel layout, colour matching, the single-colour lower-left panel and the scenario are as in Fig.~\ref {fig:normal}, and both rows again contain $N = 1000$ observations. Comparing the lower-left panel with the upper-left one shows the artefact directly: the continuous density gradient of the original becomes a set of discrete rectangular patches}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cluster-count agreement between synthetic and original data, against separation and stratified by the true number of groups, under two reference conventions. (a) Agreement with the number of groups planted by the simulation ($\mathrm  {RR}$). (b) Agreement with the number a clustering algorithm recovers from the original data ($\mathrm  {AG}$). In panel (a), agreement is low while the groups overlap (shaded) for $k \ge 3$ and moderate for $k = 2$; panel (b) stays high throughout and depends far less on $k$, because in the overlapping regime the algorithms often fail to recover the planted count from the original data as well, so both sides of the comparison deviate from the truth in the same way. The two algorithms track each other closely under (a) and separate under (b). Both panels use all $720{,}000$ original--synthetic pairs.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:recovery}{{3}{12}{Cluster-count agreement between synthetic and original data, against separation and stratified by the true number of groups, under two reference conventions. (a) Agreement with the number of groups planted by the simulation ($\mathrm {RR}$). (b) Agreement with the number a clustering algorithm recovers from the original data ($\mathrm {AG}$). In panel (a), agreement is low while the groups overlap (shaded) for $k \ge 3$ and moderate for $k = 2$; panel (b) stays high throughout and depends far less on $k$, because in the overlapping regime the algorithms often fail to recover the planted count from the original data as well, so both sides of the comparison deviate from the truth in the same way. The two algorithms track each other closely under (a) and separate under (b). Both panels use all $720{,}000$ original--synthetic pairs}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Geometric fidelity}{12}{subsection.3.3}\protected@file@percent }
\citation{xiong2009}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Agreement in the number of groups by design factor, over the full 720{,}000-evaluation design, under the two references of Eq.~\eqref  {eq:sr}: the planted number of groups ($\mathrm  {RR}$) and the number estimated from the original data ($\mathrm  {AG}$). Each entry is a marginal mean over all other factors. Candidate range $\{2,\dots  ,\min (k+3,8)\}$; the fixed-range analysis is in Supplementary Table~S2.}}{13}{table.2}\protected@file@percent }
\newlabel{tab:factors}{{2}{13}{Agreement in the number of groups by design factor, over the full 720{,}000-evaluation design, under the two references of Eq.~\eqref {eq:sr}: the planted number of groups ($\mathrm {RR}$) and the number estimated from the original data ($\mathrm {AG}$). Each entry is a marginal mean over all other factors. Candidate range $\{2,\dots ,\min (k+3,8)\}$; the fixed-range analysis is in Supplementary Table~S2}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Geometric fidelity against separation. Points show the mean of the 36 scenario-level means at each separation level; bands are $95\%$ intervals computed across those scenarios. Left: mean centroid distance. Right: mean variance difference. Both panels share the vertical scale. Both metrics decline as groups separate, and $k$-means remains below Ward throughout.}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:fidelity}{{4}{14}{Geometric fidelity against separation. Points show the mean of the 36 scenario-level means at each separation level; bands are $95\%$ intervals computed across those scenarios. Left: mean centroid distance. Right: mean variance difference. Both panels share the vertical scale. Both metrics decline as groups separate, and $k$-means remains below Ward throughout}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces (a) Mean variance difference by dimensionality: total distortion accumulates as dimensions are added, more so for Ward; per coordinate it is roughly constant (see text). (b) Group-balance error $\Delta G$ by distribution family: $k$-means produces lower and less variable balance error for both distributions. Bars are means of scenario-level means; error bars are $95\%$ intervals computed across scenarios.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:balance}{{5}{14}{(a) Mean variance difference by dimensionality: total distortion accumulates as dimensions are added, more so for Ward; per coordinate it is roughly constant (see text). (b) Group-balance error $\Delta G$ by distribution family: $k$-means produces lower and less variable balance error for both distributions. Bars are means of scenario-level means; error bars are $95\%$ intervals computed across scenarios}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Distribution family}{14}{subsection.3.4}\protected@file@percent }
\newlabel{sec:distribution}{{3.4}{14}{Distribution family}{subsection.3.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cluster-count agreement by distribution family and separation, under the two references. (a) Versus the planted number of groups: the two families show similar recovery while groups overlap and diverge at intermediate separation, where recovery is lower for Gamma data for both algorithms. (b) Versus the number recovered from the original data: the Gamma penalty attributable to synthesis is largest in the overlapping regime and for Ward.}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:distribution}{{6}{15}{Cluster-count agreement by distribution family and separation, under the two references. (a) Versus the planted number of groups: the two families show similar recovery while groups overlap and diverge at intermediate separation, where recovery is lower for Gamma data for both algorithms. (b) Versus the number recovered from the original data: the Gamma penalty attributable to synthesis is largest in the overlapping regime and for Ward}{figure.6}{}}
