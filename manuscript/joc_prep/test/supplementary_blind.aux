\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Agreement in the estimated number of groups between original and synthetic data, by separation. Rows are $\hat  {k}$ from the original data, columns $\hat  {k}$ from the synthetic data; cells are percentages of all comparisons at that separation (each block sums to $100\%$). Estimates of five or more groups are pooled for display, but the agreement column is computed on unpooled values. Both data sources are searched over a fixed range $\hat  {k} \in \{2,\dots  ,8\}$, so the comparison is symmetric; under the narrower per-scenario range used for the recovery rates in the main text, agreement is higher in the overlapping regime ($75.1\%$ and $67.6\%$ at $\sigma = 0.1$, $79.7\%$ and $75.9\%$ at $\sigma = 2$, for $k$-means and Ward respectively) and essentially unchanged at $\sigma \ge 6$, where the two conventions differ by at most $0.1$ percentage points. $n = 180{,}000$ comparisons per separation level.}}{4}{table.1}\protected@file@percent }
\newlabel{tabS:khat}{{S1}{4}{Agreement in the estimated number of groups between original and synthetic data, by separation. Rows are $\hat {k}$ from the original data, columns $\hat {k}$ from the synthetic data; cells are percentages of all comparisons at that separation (each block sums to $100\%$). Estimates of five or more groups are pooled for display, but the agreement column is computed on unpooled values. Both data sources are searched over a fixed range $\hat {k} \in \{2,\dots ,8\}$, so the comparison is symmetric; under the narrower per-scenario range used for the recovery rates in the main text, agreement is higher in the overlapping regime ($75.1\%$ and $67.6\%$ at $\sigma = 0.1$, $79.7\%$ and $75.9\%$ at $\sigma = 2$, for $k$-means and Ward respectively) and essentially unchanged at $\sigma \ge 6$, where the two conventions differ by at most $0.1$ percentage points. $n = 180{,}000$ comparisons per separation level}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Recovery of the planted number of groups (RR) and agreement with the number estimated from the original data (AG), by separation, under the per-scenario candidate range used in the main text and under a fixed range. Wilcoxon $p$: paired signed-rank test of $k$-means versus Ward across the 144 scenario-level means.}}{5}{table.2}\protected@file@percent }
\newlabel{tabS:range}{{S2}{5}{Recovery of the planted number of groups (RR) and agreement with the number estimated from the original data (AG), by separation, under the per-scenario candidate range used in the main text and under a fixed range. Wilcoxon $p$: paired signed-rank test of $k$-means versus Ward across the 144 scenario-level means}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Synthetic-versus-original agreement (AG) and the independent-resampling baseline (proportion of pairs of independent original datasets in the same scenario with equal $\hat  {k}_R$). Means over scenarios; candidate range $\{2,\dots  ,\min (k+3,8)\}$.}}{5}{table.3}\protected@file@percent }
\newlabel{tabS:baseline}{{S3}{5}{Synthetic-versus-original agreement (AG) and the independent-resampling baseline (proportion of pairs of independent original datasets in the same scenario with equal $\hat {k}_R$). Means over scenarios; candidate range $\{2,\dots ,\min (k+3,8)\}$}{table.3}{}}
