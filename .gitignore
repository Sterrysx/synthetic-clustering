# generated datasets (2.1 GB) -- regenerate with the R scripts.
# No trailing slash: `data` is a symlink here, and `data/` matches directories only.
data
# LaTeX build products
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.log
manuscript/*.out
manuscript/*.build.log
manuscript/missfont.log
manuscript/texfmt/
manuscript/*.fdb_latexmk
manuscript/*.fls
# derived results -- all regenerable by `make all`, and far too large to track:
# clustering_results.csv alone is 199 MB, past GitHub's 100 MB hard limit.
# The small khat_agreement*.csv summaries ARE kept.
results/*.parquet
results/clustering_results.csv
results/.partial_*/
results/.design-m*
# per-phase stage logs from scripts/pipeline.py
results/logs/
# python
.venv/
__pycache__/
*.pyc
.uv-cache/
.pytest_cache/

# Local Git worktrees
.worktrees/

# case study: synthetic draws and per-draw metrics are regenerable in ~1 min
# (scripts/case_study/); the original data, summaries and info files are kept.
results/case_study/diabetes_synthetic*.csv
results/case_study/diabetes_draws*.csv
# root-level copies of the submission builds (the deliverables are in manuscript/submission/)
manuscript/main_blind.pdf
manuscript/main_named.pdf
manuscript/supplementary_blind.pdf
manuscript/supplementary_named.pdf
manuscript/title_page.pdf
manuscript/main_diff_v4_v5.pdf
manuscript/cover_letter.pdf
manuscript/main_diff_v4_v5.tex
manuscript/*.bibtex.log
manuscript/*.latexdiff.log
manuscript/pdflatex.fmt
